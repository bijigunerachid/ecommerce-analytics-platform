# Copy to .env and replace every placeholder. Never commit .env.
# PowerShell:  Copy-Item .env.example .env

# ---- PostgreSQL ----
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# Separate database used only by automated tests (created automatically by Docker on first start).
POSTGRES_TEST_DB=ecommerce_test

# ---- Backend API ----
API_PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-generate-a-long-random-string
# Session length in seconds (cookie and token expire together).
JWT_TTL_SECONDS=3600
# bcrypt cost factor for password hashing (12 = ~250 ms per hash).
BCRYPT_ROUNDS=12
# Secure cookies are only sent over HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
# Login attempts allowed per client IP per window.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ---- Kafka ----
# Brokers as seen from your machine. Containers on the Compose network use kafka:29092.
KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
# Topics are <prefix>.orders and <prefix>.inventory.
KAFKA_TOPIC_PREFIX=ecommerce
# Outbox relay tuning (optional).
# OUTBOX_BATCH_SIZE=100
# OUTBOX_POLL_INTERVAL_MS=500

# ---- Frontend ----
VITE_API_URL=http://localhost:4000/api
