# Copy to .env and replace every placeholder. Never commit .env.
# PowerShell:  Copy-Item .env.example .env
# Generate a secret (PowerShell):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
# Save this file as UTF-8 without BOM (VS Code / Notepad default).

# ---- PostgreSQL ----
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# Separate database used only by automated tests (created automatically by Docker on first start).
POSTGRES_TEST_DB=ecommerce_test

# ---- Backend API ----
API_PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-generate-a-long-random-string
# Session length in seconds (cookie and token expire together).
JWT_TTL_SECONDS=3600
# bcrypt cost factor for password hashing (12 = ~250 ms per hash).
BCRYPT_ROUNDS=12
# Secure cookies are only sent over HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
# Login attempts allowed per client IP per window.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ---- Docker Compose (full stack) ----
# The web app is published on http://localhost:WEB_PORT; nginx proxies /api to the API container.
WEB_PORT=8080
# Origin the browser uses for the Docker stack (must match WEB_PORT).
WEB_ORIGIN=http://localhost:8080
# COOKIE_SECURE=true only when the app is served over HTTPS (plain http://localhost needs false).
# Reverse proxies in front of the API. The Docker stack sets 1 (nginx); keep 0 when clients
# connect to the API directly, or they could spoof their IP to the login rate limit.
# TRUST_PROXY=0

# ---- Kafka ----
# Brokers as seen from your machine. Containers on the Compose network use kafka:29092.
KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
# Topics are <prefix>.orders and <prefix>.inventory.
KAFKA_TOPIC_PREFIX=ecommerce
# KAFKA_CLIENT_ID=ecommerce-outbox-relay
# Outbox relay tuning (optional).
# OUTBOX_BATCH_SIZE=100
# OUTBOX_POLL_INTERVAL_MS=500

# ---- Frontend ----
# The Vite dev server proxies /api to the backend (http://localhost:API_PORT), so the browser
# stays on one origin and the session cookie just works. Override the proxy target if needed:
# VITE_API_PROXY_TARGET=http://localhost:4000
# API base URL baked into the frontend build; keep /api when the API is on the same origin:
# VITE_API_URL=/api
# Currency for displaying money values:
# VITE_CURRENCY=EUR
