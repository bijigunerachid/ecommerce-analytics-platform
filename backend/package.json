{
  "name": "ecommerce-analytics-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express REST API for the Real-Time E-Commerce Analytics Platform",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "relay": "node --env-file-if-exists=../.env src/workers/outbox-relay.js",
    "generate-data": "node --env-file-if-exists=../.env scripts/generate-sample-data.js",
    "create-admin": "node --env-file-if-exists=../.env scripts/create-admin.js",
    "migrate:up": "node --env-file-if-exists=../.env scripts/migrate.js up",
    "migrate:down": "node --env-file-if-exists=../.env scripts/migrate.js down",
    "migrate:test": "node --env-file-if-exists=../.env scripts/migrate.js up --test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@confluentinc/kafka-javascript@1.10.1": true
  }
}
